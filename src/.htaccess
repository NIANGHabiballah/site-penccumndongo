# Security Headers (conditionally loaded)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# HTTPS Redirect et normalisation domaine
RewriteEngine On

# Redirections spécifiques pour éviter les boucles et problèmes d'indexation
RewriteRule ^accueil/?$ / [L,R=301]

# Redirections canoniques pour les pages principales
RewriteRule ^index\.html?$ / [L,R=301]
RewriteRule ^home/?$ / [L,R=301]

# Redirections pour les pages avec trailing slash
RewriteRule ^apropos/$ /apropos [L,R=301]
RewriteRule ^formations/$ /formations [L,R=301]
RewriteRule ^opportunites/$ /opportunites [L,R=301]
RewriteRule ^politique-confidentialite/$ /politique-confidentialite [L,R=301]
RewriteRule ^cgv/$ /cgv [L,R=301]

# Hide sensitive files
<Files ~ "^\.">
    <RequireAll>
        Require all denied
    </RequireAll>
</Files>

<Files ~ "\.(log|sql|bak|backup)$">
    <RequireAll>
        Require all denied
    </RequireAll>
</Files>

# Prevent access to PHP files in uploads
# PHP files blocked - commented out for forms
# <FilesMatch "\.(php|php3|php4|php5|phtml)$">
#     Order Deny,Allow
#     Deny from all
# </FilesMatch>

# Sécurité pour les uploads de profil
<Directory "uploads">
    # Autoriser seulement les images
    <FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
        Require all granted
    </FilesMatch>
    
    # Bloquer l'exécution de scripts
    <FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
        Require all denied
    </FilesMatch>
    
    # Désactiver l'indexation
    Options -Indexes
</Directory>





# Angular routing
RewriteEngine On

# Explicitly allow cp2i route
RewriteRule ^cp2i/?$ /index.html [L]

# Allow access to other Angular routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/cp2i-.*\.php$
RewriteRule . /index.html [L]

